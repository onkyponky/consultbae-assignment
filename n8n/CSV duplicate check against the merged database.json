    {
      "parameters": {
        "jsCode": "// Build the duplicate alert from every checked row.\n// The lookup endpoint only answered \"does this person exist?\".\n// Deciding what that means, and what the alert says, happens here.\n\nconst rows = $input.all().map(item => item.json);\n\nconst duplicates = rows.filter(row => row.status === 'duplicate');\nconst fresh = rows.filter(row => row.status === 'new');\n\nreturn [{\n  json: {\n    alert: duplicates.length > 0\n      ? `${duplicates.length} of ${rows.length} incoming rows already exist in the database.`\n      : `No duplicates. All ${rows.length} rows are new people.`,\n    checked: rows.length,\n    duplicates: duplicates.length,\n    new: fresh.length,\n    alerts: duplicates.map(row => ({\n      name: row.name,\n      submitted_phone: row.phone,\n      submitted_email: row.email || null,\n      matched_on: row.matched_on,\n      collides_with: row.person\n    })),\n    new_people: fresh.map(row => ({\n      name: row.name,\n      phone: row.phone,\n      email: row.email || null\n    }))\n  }\n}];"
      },
      "id": "198212c5-ac19-4504-aa3f-37a36ab00147",
      "name": "Build Alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
